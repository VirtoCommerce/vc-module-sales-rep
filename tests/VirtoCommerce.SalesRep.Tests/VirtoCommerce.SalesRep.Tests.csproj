<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <NoWarn>NU1608;xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="8.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.9" />
    <!-- Override EF Core's transitive SQLitePCLRaw 2.1.11 (SQLite < 3.50.2, CVE-2025-6965) with the patched 3.x
         native bundle. Test-only in-memory DB; not shipped. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageReference Include="VirtoCommerce.Platform.Caching" Version="3.1039.6" />
    <PackageReference Include="VirtoCommerce.SearchModule.Core" Version="3.1004.0" />
    <PackageReference Include="VirtoCommerce.SearchModule.Data" Version="3.1004.0" />
    <PackageReference Include="VirtoCommerce.LuceneSearchModule.Data" Version="3.1002.0" />
    <!-- Other modules' .Data assemblies are used only to build the test harness (seed the DbContexts, wire the real
         Customer/Order search + event services). The module under test references only their .Core. -->
    <PackageReference Include="VirtoCommerce.CustomerModule.Data" Version="3.1014.0" />
    <PackageReference Include="VirtoCommerce.OrdersModule.Data" Version="3.1010.0" />
    <PackageReference Include="VirtoCommerce.CartModule.Data" Version="3.1006.0" />
    <PackageReference Include="VirtoCommerce.CatalogModule.Data" Version="3.1032.0" />
    <!-- Store .Core only: the harness registers a lightweight in-memory IStoreService double (TestStoreService)
         so the real SalesRepService can read the store's ContactDefaultStatus. No Store .Data/DbContext needed. -->
    <PackageReference Include="VirtoCommerce.StoreModule.Core" Version="3.1005.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- TEMP — REMOVE WHEN VULNERABILITY FIXED. CatalogModule.Data (referenced only for the Top Sellers catalog test
         slice) → HtmlSanitizer → AngleSharp 0.17.1: a moderate transitive advisory that TreatWarningsAsErrors turns
         into a build error. Test-only (never shipped). Remove once AngleSharp is patched upstream (or fold into a
         permanent suppression like the SQLite one above). -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-pgww-w46g-26qg" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\VirtoCommerce.SalesRep.Core\VirtoCommerce.SalesRep.Core.csproj" />
    <ProjectReference Include="..\..\src\VirtoCommerce.SalesRep.Data\VirtoCommerce.SalesRep.Data.csproj" />
    <ProjectReference Include="..\..\src\VirtoCommerce.SalesRep.ExperienceApi\VirtoCommerce.SalesRep.ExperienceApi.csproj" />
    <ProjectReference Include="..\..\src\VirtoCommerce.SalesRep.Web\VirtoCommerce.SalesRep.Web.csproj" />
  </ItemGroup>
</Project>
