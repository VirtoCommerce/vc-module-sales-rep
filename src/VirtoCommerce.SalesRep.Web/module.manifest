<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.SalesRep</id>
  <version>3.1000.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1039.0</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.Customer" version="3.1014.0" />
    <dependency id="VirtoCommerce.Xapi" version="3.1012.0" />
    <dependency id="VirtoCommerce.Orders" version="3.1010.0" />
    <dependency id="VirtoCommerce.Store" version="3.1005.0" />
  </dependencies>

  <apps>
    <app id="vc-sales-rep">
      <title>Sales Reps</title>
      <description>Manage Sales Representatives, their organizations and accounts</description>
      <iconUrl>Modules/$(VirtoCommerce.SalesRep)/Content/logo.svg</iconUrl>
      <permission>customer:read</permission>
      <supportEmbeddedMode>true</supportEmbeddedMode>
    </app>
  </apps>

  <title>Virto Commerce Sales Rep</title>
  <description>Virto Commerce Sales Rep</description>

  <authors>
    <author>Alla Volkova</author>
  </authors>
  <owners>
    <owner>Virto Commerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-sales-rep</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.SalesRep)/Content/logo.svg</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.SalesRep.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.SalesRep.Web.Module, VirtoCommerce.SalesRep.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 Virto Commerce. All rights reserved</copyright>
  <tags>extension module</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
