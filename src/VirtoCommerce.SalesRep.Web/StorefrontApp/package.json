{
  "name": "sales-rep",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "preview": "vite preview --port 3001",
    "dev": "vite --port 3001",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css}\"",
    "test": "vitest run",
    "generate:graphql-types": "graphql-codegen --config codegen.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vc-frontend/core": "https://github.com/VirtoCommerce/vc-frontend/releases/download/core-v0.1.0/vc-frontend-core-0.1.0.tgz"
  },
  "devDependencies": {
    "@apollo/client": "^3.14.1",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@graphql-codegen/add": "5.0.3",
    "@graphql-codegen/cli": "5.0.7",
    "@graphql-codegen/named-operations-object": "3.1.1",
    "@graphql-codegen/typed-document-node": "5.1.2",
    "@graphql-codegen/typescript": "4.1.6",
    "@graphql-codegen/typescript-operations": "4.6.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@module-federation/vite": "1.16.12",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/lodash-es": "^4.17.12",
    "@types/sortablejs": "^1.15.9",
    "@vee-validate/yup": "^4.15.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/apollo-composable": "^4.2.2",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^14.3.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.9.2",
    "globals": "^16.5.0",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "lodash-es": "^4.18.1",
    "maska": "^3.2.0",
    "postcss": "^8.5.16",
    "postcss-import": "^16.1.1",
    "prettier": "^3.9.4",
    "sass-embedded": "^1.94.1",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^3.4.19",
    "tw-elements": "^1.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.1",
    "utility-types": "^3.11.0",
    "vee-validate": "^4.15.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.4",
    "vue": "3.5.39",
    "vue-i18n": "^11.4.6",
    "vue-router": "^4.6.4",
    "vue-tsc": "3.3.5",
    "yup": "^1.7.1"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix"
