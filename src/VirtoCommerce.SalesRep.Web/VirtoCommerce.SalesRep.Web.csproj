<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <NoWarn>1591;NU1608</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
    <Compile Remove="App\**" />
    <Content Remove="App\**" />
    <EmbeddedResource Remove="App\**" />
    <None Remove="App\**" />
    <Compile Remove="StorefrontApp\**" />
    <Content Remove="StorefrontApp\**" />
    <EmbeddedResource Remove="StorefrontApp\**" />
    <None Remove="StorefrontApp\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Localizations\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.NotificationsModule.TemplateLoader.FileSystem" Version="3.1009.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.SalesRep.Core\VirtoCommerce.SalesRep.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.SalesRep.Data\VirtoCommerce.SalesRep.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.SalesRep.ExperienceApi\VirtoCommerce.SalesRep.ExperienceApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <NotificationTemplates Include="NotificationTemplates\**" />
  </ItemGroup>
  <!--
    Builds the storefront MF plugin into plugins/vc-frontend/ so the packed module carries it.
    vc-build's BuildCustomApp cannot do this: it walks <apps> from module.manifest, only looks in
    Apps/{appId} (or the legacy App/), and copies dist into Content/{appId} — and declaring the
    plugin as an <app> would both claim a host app id we do not own and drop the App/ fallback the
    admin UI relies on. Pass -p:SkipStorefrontPlugin=true for a backend-only build without node.
  -->
  <Target Name="BuildStorefrontPlugin" BeforeTargets="Publish" Condition="'$(SkipStorefrontPlugin)' != 'true' AND Exists('$(MSBuildProjectDirectory)\StorefrontApp\package.json')">
    <!-- The runner's global yarn is 1.x; package.json pins yarn 4, so corepack has to activate it. -->
    <Exec Command="corepack enable" ContinueOnError="true" />
    <Exec Command="yarn install --immutable" WorkingDirectory="$(MSBuildProjectDirectory)\StorefrontApp" />
    <Exec Command="yarn build" WorkingDirectory="$(MSBuildProjectDirectory)\StorefrontApp" />
  </Target>
  <!--
    The default Content glob is evaluated before any target runs, so files the build above creates
    are invisible to it. They are added to the publish set explicitly instead.
  -->
  <Target Name="PublishStorefrontPlugin" DependsOnTargets="BuildStorefrontPlugin" BeforeTargets="ComputeResolvedFilesToPublishList" Condition="'$(SkipStorefrontPlugin)' != 'true'">
    <ItemGroup>
      <StorefrontPluginFile Include="$(MSBuildProjectDirectory)\plugins\**\*" />
      <ResolvedFileToPublish Include="@(StorefrontPluginFile)">
        <RelativePath>plugins\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
  <Target Name="CopyCustomContentOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(NotificationTemplates)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
</Project>
