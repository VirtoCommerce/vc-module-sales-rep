<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- CoreModule.Core: the Sales Rep dictionaries endpoint reads the currency catalog (ICurrencyService) to
         populate the admin Currency dropdown from VirtoCommerce data. Version matches the module.manifest
         VirtoCommerce.Core dependency (same version the Customer module depends on). -->
    <PackageReference Include="VirtoCommerce.CoreModule.Core" Version="3.1007.0" />
    <!-- OrdersModule.Data (scoped, deliberate exception to "reference other modules' .Core, not .Data"):
         (1) the order search subclasses the Orders module's CustomerOrderSearchService (which lives in .Data) to
             reuse its query/hydration pipeline for the grouped "latest order per organization" lookup; and
         (2) sales statistics (VCST-5309) read the Orders EF store (IOrderRepository) directly to run DB-side
             SUM/COUNT/MAX instead of loading orders into memory (the public order search service can't aggregate).
         Version matches the OrdersModule.Core reference in SalesRep.Core and the module.manifest VirtoCommerce.Orders dependency. -->
    <PackageReference Include="VirtoCommerce.OrdersModule.Data" Version="3.1010.0" />
    <!-- CartModule.Data (same scoped, deliberate .Data exception as Orders.Data): cart/project statistics read the
         Cart EF store (ICartRepository) directly to run DB-side SUM/COUNT/MAX instead of loading carts into memory.
         Version matches the module.manifest VirtoCommerce.Cart dependency. -->
    <PackageReference Include="VirtoCommerce.CartModule.Data" Version="3.1008.0-alpha.803-vcst-5332-customer-wishlist-sharing-scope" />
    <!-- StoreModule.Core: reads the store's Customer.ContactDefaultStatus setting (via IStoreService) to seed a
         new Sales Rep's member status. Version matches the module.manifest VirtoCommerce.Store dependency. -->
    <PackageReference Include="VirtoCommerce.StoreModule.Core" Version="3.1006.0" />
    <!-- XCart.Data (same scoped, deliberate .Data exception as Orders.Data/Cart.Data): SalesRepCartSharingService
         subclasses the XCart module's CartSharingService (which lives in .Data) to teach the sharing pipeline the
         "Customer" scope (VCST-5332). VCST-5332/F1 adds the write-path guards ValidateSharingSettings +
         AuthorizeSharingAsync to XCart, so we now build against local XCart source.
         TEMP local shim: revert to <PackageReference Include="VirtoCommerce.XCart.Data" Version="<new XCart alpha>" />
         once a new XCart alpha (with the guards) is published. -->
    <ProjectReference Include="..\..\..\vc-module-x-cart\src\VirtoCommerce.XCart.Data\VirtoCommerce.XCart.Data.csproj" />
    <!-- TEMP local shim: raised from 3.1039.6 to satisfy the local XCart source (Platform 3.1048). Revert to
         3.1039.6 once building against a published XCart alpha on the 3.1039 line. -->
    <PackageReference Include="VirtoCommerce.Platform.Data" Version="3.1048.0" />
    <PackageReference Include="VirtoCommerce.Platform.Security" Version="3.1048.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.SalesRep.Core\VirtoCommerce.SalesRep.Core.csproj" />
  </ItemGroup>
</Project>
