<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- OrdersModule.Data: the Sales Rep order search subclasses the Orders module's CustomerOrderSearchService
         (which lives in .Data) to reuse its query/hydration pipeline. Version matches the OrdersModule.Core
         reference in SalesRep.Core and the module.manifest VirtoCommerce.Orders dependency. -->
    <PackageReference Include="VirtoCommerce.OrdersModule.Data" Version="3.1010.0" />
    <!-- StoreModule.Core: reads the store's Customer.ContactDefaultStatus setting (via IStoreService) to seed a
         new Sales Rep's member status. Version matches the module.manifest VirtoCommerce.Store dependency. -->
    <PackageReference Include="VirtoCommerce.StoreModule.Core" Version="3.1005.0" />
    <PackageReference Include="VirtoCommerce.Platform.Data" Version="3.1039.0" />
    <PackageReference Include="VirtoCommerce.Platform.Security" Version="3.1039.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.SalesRep.Core\VirtoCommerce.SalesRep.Core.csproj" />
  </ItemGroup>
</Project>
